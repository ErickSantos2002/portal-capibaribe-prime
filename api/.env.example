# Variáveis da API. Copie para .env (fora do Git) só se for usar localmente; em produção elas
# ficam na Vercel e no GitHub. Os valores abaixo são do Postgres local de desenvolvimento.

# Usuário app (o que a API usa). Em produção: pooler do Neon, com ?sslmode=require.
DATABASE_URL=postgresql://app:app-teste@127.0.0.1:55432/portal_dev

# Usuário dono (só migrações). Em produção: conexão direta do Neon, sem o pooler.
DATABASE_URL_DONO=postgresql://dono:dono-teste@127.0.0.1:55432/portal_dev

# O administrador não vem mais de variável: depois do primeiro acesso da unidade dele,
#   uv run --env-file .env python -m app.comandos.promover_admin <login>

# Segredo da rota POST /api/diagnostico/erro (cabeçalho X-Portal-Diagnostico). Vazio = desligada.
PORTAL_DIAGNOSTICO_SEGREDO=

# Libera os dados fictícios (local ou teste). Nunca definir em produção.
PORTAL_AMBIENTE=local

# --- M2: notificações e e-mail (spec do M2, seção 6). Vazio = canal desligado, nada quebra. ---

# Web Push. Gere com: uv run python -m app.comandos.gerar_chaves_vapid (a pública sai da
# privada). Na Vercel, como variável sensível; a prévia usa um par diferente da produção.
PORTAL_VAPID_PRIVADA=
# Contato que os serviços de push (Google, Apple, Mozilla) usam se algo der errado.
PORTAL_VAPID_CONTATO=

# E-mail pelo Gmail do Portal (ADR-0006): o endereço e uma senha de app (não a senha da conta).
PORTAL_SMTP_USUARIO=
PORTAL_SMTP_SENHA_APP=
# Opcionais (padrão: smtp.gmail.com, 465 com TLS direto).
# PORTAL_SMTP_HOST=smtp.gmail.com
# PORTAL_SMTP_PORTA=465

# Endereço do Portal nos links dos e-mails ("esqueci a senha", cópia do aviso). Nunca vem do
# cabeçalho Host. Em produção: https://portal-capibaribe-prime.vercel.app
PORTAL_URL_BASE=http://localhost:5173
