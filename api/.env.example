# Variáveis da API. Copie para .env (fora do Git) só se for usar localmente; em produção elas
# ficam na Vercel e no GitHub. Os valores abaixo são do Postgres local de desenvolvimento.

# Usuário app (o que a API usa). Em produção: pooler do Neon, com ?sslmode=require.
DATABASE_URL=postgresql://app:app-teste@127.0.0.1:55432/portal_dev

# Usuário dono (só migrações). Em produção: conexão direta do Neon, sem o pooler.
DATABASE_URL_DONO=postgresql://dono:dono-teste@127.0.0.1:55432/portal_dev

# Login da unidade do administrador na carga inicial. No repositório, só a fictícia 1101.
PORTAL_ADMIN_UNIDADE=1101

# Segredo da rota POST /api/diagnostico/erro (cabeçalho X-Portal-Diagnostico). Vazio = desligada.
PORTAL_DIAGNOSTICO_SEGREDO=

# Libera os dados fictícios (local ou teste). Nunca definir em produção.
PORTAL_AMBIENTE=local
